{
  "name": "m1inra1/e-commerce",
  "description": "Boutique e-commerce PHP - dépendances de développement",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "php-webdriver/webdriver": "^1.16",
    "phpunit/phpunit": "^11.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test:e2e": "@php vendor/bin/phpunit --testsuite E2E"
  },
  "config": {
    "sort-packages": true
  }
}
